---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import bricolage from '../assets/fonts/bricolage.woff2?url';
import sourceSerifRoman from '../assets/fonts/source-serif-roman.woff2?url';
import RunningHead from '../components/RunningHead.astro';
import Footer from '../components/Footer.astro';
import { person } from '../data/site';
import { publicPath } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Path to the Open Graph image, e.g. /og/default.png */
  ogImage?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = person.description,
  ogImage = '/og/default.png',
  type = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${person.name}` : `${person.name} — Essays and research`;
const canonical = new URL(publicPath(Astro.url.pathname), Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sourceSerifRoman} as="font" type="font/woff2" crossorigin />

    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fbf8f3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title ?? person.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? person.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <RunningHead />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
