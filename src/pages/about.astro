---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import TapedPrint from '../components/TapedPrint.astro';
import { cv, methods } from '../data/cv';
import { person } from '../data/site';
import { personLd } from '../lib/seo';
import portrait from '../assets/images/portrait.jpg';
import field from '../assets/images/field-4x5.jpg';

const num = (n: number) => String(n + 1).padStart(2, '0');
// Each date is a rubber stamp, pressed at its own slightly careless angle.
const stampTilt = (i: number, j: number) => [-4, 3, -2, 5, -3, 2, -5][(i * 3 + j) % 7];
---

<Base
  title="About"
  description="Shreyashi Bista: conservation researcher from Kathmandu, Nepal. Education, research and policy experience, funding and training."
  jsonLd={[personLd(Astro.site!)]}
>
  <header class="page-head wrap grid bleed" style="--band: var(--lilac)">
    <p class="label">03 — About</p>
    <h1 class="page-title">About</h1>
  </header>

  <div class="wrap grid intro">
    <div class="plates">
      <TapedPrint
        image={portrait}
        alt="Shreyashi Bista, smiling, in a blue dress, standing at the arch of a stone cloister."
        caption="Plate I"
        tilt={-2}
        widths={[320, 480, 640]}
        sizes="(min-width: 64em) 28vw, (min-width: 48em) 40vw, 75vw"
        loading="eager"
        priority
      />
      <TapedPrint
        class="field"
        image={field}
        alt="Shreyashi Bista on a boulder-strewn forest trail, smiling, with a camera, a backpack and a jacket over her arm."
        caption="Plate II · In the field"
        tilt={3}
        tape={6}
        widths={[280, 420, 560]}
        sizes="(min-width: 64em) 22vw, (min-width: 48em) 32vw, 60vw"
      />
    </div>
    <div class="bio">
      <p class="first">
        Shreyashi Bista is a conservation researcher from Kathmandu, Nepal. Her work sits where wildlife ecology meets
        people: Asiatic black bears and the communities who live beside them in Gaurishankar, compensation for wildlife
        damage around Shuklaphanta National Park, and the place of gender and social inclusion in Nepal’s biodiversity
        planning.
      </p>
      <p>
        She trained in forestry at the Institute of Forestry, Tribhuvan University, and in wildlife ecology and
        management at Kathmandu University. She has since completed the academic requirements of an MSc in
        Sustainability and Environmental Management at Coventry University, where her dissertation on the care ethics
        of Nepal’s wildlife damage relief was awarded a Distinction.
      </p>
      <p>
        She also writes essays, on gender, family and the natural world, and is a member of the editorial team at
        GlobalNYT.
      </p>
      <p class="download">
        <a class="arrow-link" href={person.cvPdf} download>Download CV (PDF)</a>
        <a class="arrow-link" href="/research">Publications</a>
      </p>
    </div>
  </div>

  <div class="wrap cv">
    {
      cv.map((section, i) => (
        <section class="cv-section" aria-labelledby={section.id}>
          <SectionHead number={num(i)} title={section.title} id={section.id} />
          <ol class="entries" role="list">
            {section.entries.map((e, j) => (
              <li class="grid entry" style={`--stamp: ${stampTilt(i, j)}deg`}>
                {e.when ? <span class="when">{e.when}</span> : <span class="when-none" />}
                <div class="what">
                  <h3>{e.title}</h3>
                  {e.org && <p class="org">{e.org}</p>}
                  {e.body && <p class="body" set:html={e.body} />}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <section class="cv-section" aria-labelledby="methods">
      <SectionHead number={num(cv.length)} title="Research methods and technical skills" id="methods" />
      <ol class="entries" role="list">
        {
          methods.map((m) => (
            <li class="grid entry">
              <span class="when-none" />
              <div class="what">
                <h3>{m.title}</h3>
                <p class="body">{m.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <p class="grid end">
      <a class="arrow-link" href={person.cvPdf} download>Download CV (PDF)</a>
    </p>
  </div>
</Base>

<style>
  .intro {
    row-gap: var(--space-6);
    align-items: start;
  }

  .plates {
    grid-column: 1 / span 3;
    display: grid;
    gap: var(--space-7);
    padding-top: var(--space-3);
  }

  .plates :global(.field) {
    width: 80%;
    justify-self: end;
  }

  .bio {
    grid-column: 1 / -1;
    max-width: 38rem;
  }

  .bio p {
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .bio p + p {
    margin-top: var(--space-4);
  }

  .bio .first {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 650;
    font-stretch: 88%;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--ink);
    margin-bottom: var(--space-6);
  }

  .download {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    padding-top: var(--space-5);
  }

  .cv {
    margin-top: var(--space-8);
  }

  .cv-section + .cv-section {
    margin-top: var(--space-8);
  }

  .entries {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }

  .entry {
    row-gap: var(--space-3);
    align-items: start;
  }

  /* Dates as rubber stamps in red ink: double frame, uneven angle. */
  .when {
    grid-column: 1 / -1;
    justify-self: start;
    padding: 0.35em 0.6em 0.3em;
    border: 2px solid var(--accent-deep);
    outline: 1px solid var(--accent-deep);
    outline-offset: 2px;
    color: var(--accent-deep);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-variant-numeric: lining-nums tabular-nums;
    white-space: nowrap;
    rotate: var(--stamp, -3deg);
    opacity: 0.92;
  }

  .when-none {
    display: none;
  }

  .what {
    grid-column: 1 / -1;
  }

  h3 {
    font-family: var(--font-text);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .org {
    font-style: italic;
    color: var(--ink-2);
  }

  .body {
    margin-top: var(--space-2);
    max-width: 62ch;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .end {
    margin-top: var(--space-7);
  }

  .end a {
    grid-column: 1 / -1;
  }

  @media (min-width: 48em) {
    .plates {
      grid-column: 1 / span 3;
      position: sticky;
      top: var(--space-6);
    }
    .bio {
      grid-column: 5 / -1;
    }
    .when {
      grid-column: 1 / span 2;
      justify-self: end;
      margin-top: 0.1em;
    }
    .when-none {
      display: block;
      grid-column: 1 / span 2;
    }
    .what {
      grid-column: 3 / -1;
    }
    .end a {
      grid-column: 3 / -1;
    }
  }

  @media (min-width: 64em) {
    .plates {
      grid-column: 1 / span 4;
    }
    .bio {
      grid-column: 6 / span 6;
    }
    .when,
    .when-none {
      grid-column: 1 / span 3;
    }
    .what {
      grid-column: 4 / span 7;
    }
    .end a {
      grid-column: 4 / -1;
    }
  }
</style>
