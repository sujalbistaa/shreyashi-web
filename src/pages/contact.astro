---
import Base from '../layouts/Base.astro';
import { person } from '../data/site';
---

<Base title="Contact" description="How to reach Shreyashi Bista: email, ResearchGate and CV.">
  <header class="page-head wrap grid bleed" style="--band: var(--butter)">
    <p class="label">04 — Contact</p>
    <h1 class="page-title">Contact</h1>
  </header>

  <div class="wrap">
    <!-- A postcard addressed to her: message on the left, address and stamp on the right. -->
    <article class="postcard" aria-label="Contact details">
      <div class="message">
        <p class="label">Write to</p>
        <a class="email serif-i" href={`mailto:${person.email}`}>{person.email}</a>
        <ul class="links" role="list">
          <li><a href={person.researchGate} rel="me">ResearchGate</a></li>
          <li><a href={person.cvPdf} download>CV (PDF)</a></li>
        </ul>
      </div>

      <div class="address">
        <div class="stamp" aria-hidden="true">
          <svg viewBox="0 0 64 64" role="presentation">
            <ellipse cx="32" cy="36" rx="21" ry="23" fill="#e2362b" />
            <path d="M32 13 V59" stroke="#161514" stroke-width="2" />
            <circle cx="32" cy="15" r="9" fill="#161514" />
            <circle cx="22" cy="30" r="4.2" fill="#161514" />
            <circle cx="42" cy="30" r="4.2" fill="#161514" />
            <circle cx="20" cy="44" r="3.6" fill="#161514" />
            <circle cx="44" cy="44" r="3.6" fill="#161514" />
          </svg>
          <span>Nepal</span>
        </div>
        <p class="to">{person.name}</p>
        <p class="to">{person.location}</p>
        <p class="to empty" aria-hidden="true"></p>
      </div>
    </article>
  </div>
</Base>

<style>
  .postcard {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-5);
    background: #fffdf8;
    border: 2px solid var(--ink);
    rotate: -1deg;
  }

  .message {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .email {
    /* The address is 11.6em wide: sized to fit its half of the card unbroken. */
    font-size: clamp(1.25rem, 6.2vw, 2rem);
    line-height: 1.1;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.14em;
    text-decoration-color: var(--red);
    overflow-wrap: anywhere;
  }

  .links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  .links a {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 85%;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .address {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: 2px dashed var(--ink);
  }

  /* A postage stamp with perforated edges: a dotted border in card colour over the stamp. */
  .stamp {
    align-self: flex-end;
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    width: 6.5rem;
    padding: var(--space-3) var(--space-2) var(--space-2);
    margin-bottom: var(--space-5);
    background: var(--butter);
    border: 5px dotted #fffdf8;
    outline: 1.5px solid var(--ink);
    outline-offset: -5px;
    rotate: 4deg;
  }

  .stamp svg {
    width: 3.5rem;
    height: auto;
  }

  .stamp span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .to {
    min-height: 2.4rem;
    padding: var(--space-2) 0 var(--space-1);
    border-bottom: 1.5px solid var(--ink);
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 300;
    font-size: var(--step-2);
    line-height: 1.1;
  }

  @media (min-width: 48em) {
    .postcard {
      grid-template-columns: 3fr 2fr;
      gap: 0;
      padding: var(--space-7);
      min-height: 26rem;
    }
    .message {
      justify-content: space-between;
      padding-right: var(--space-6);
    }
    .email {
      font-size: clamp(1.4rem, 3.2vw, 2.9rem);
    }
    .address {
      padding-top: 0;
      padding-left: var(--space-6);
      border-top: 0;
      border-left: 2px dashed var(--ink);
    }
    .stamp {
      position: absolute;
      top: 0;
      right: 0;
    }
  }

  @media (min-width: 64em) {
    .postcard {
      max-width: 72rem;
      margin-inline: auto;
    }
  }
</style>
