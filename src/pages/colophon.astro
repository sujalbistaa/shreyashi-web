---
import Base from '../layouts/Base.astro';

const year = new Date().getFullYear();
const rows = [
  { k: 'Display', v: 'Bricolage Grotesque, by Mathieu Triay', note: 'Condensed and heavy for headlines.' },
  { k: 'Italic', v: 'Newsreader, by Production Type', note: 'The second voice: names, quotes and asides.' },
  { k: 'Text', v: 'Source Serif 4, by Frank Grießhammer for Adobe', note: 'Old-style figures in running text.' },
  { k: 'Labels', v: 'IBM Plex Mono, by Mike Abbink and Bold Monday', note: 'Numbers, dates and small print.' },
  { k: 'Colour', v: 'Paper, ink, a ladybird red and four tints', note: 'Pink for gender, mint for nature, butter for climate, lilac for her.' },
  { k: 'Built with', v: 'Astro', note: 'Static pages, and no JavaScript at all.' },
  { k: 'Fonts', v: 'Self-hosted from Fontsource', note: 'Nothing is loaded from third parties, and nothing tracks you.' },
  { k: 'Year', v: String(year) },
];
---

<Base title="Colophon" description="How this site was made: typefaces, colour and tools.">
  <header class="page-head wrap grid">
    <p class="label">Colophon</p>
    <h1 class="page-title">Colophon</h1>
  </header>
  <div class="wrap">
    <!-- Set like a magazine imprint: run-in entries in columns, no rules. -->
    <dl class="imprint">
      {
        rows.map((r) => (
          <div class="entry">
            <dt class="label">{r.k}</dt>
            <dd>
              <span class="v">{r.v}.</span> {r.note && <span class="note">{r.note}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</Base>

<style>
  .imprint {
    columns: 1;
    column-gap: var(--gutter);
    max-width: 72rem;
  }

  .entry {
    break-inside: avoid;
    margin-bottom: var(--space-6);
  }

  dt {
    margin-bottom: var(--space-1);
    color: var(--ink);
  }

  dd {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .v {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 85%;
    letter-spacing: -0.01em;
  }

  .note {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 300;
    color: var(--ink-2);
  }

  @media (min-width: 48em) {
    .imprint {
      columns: 2;
    }
  }

  @media (min-width: 64em) {
    .imprint {
      columns: 3;
    }
  }
</style>
