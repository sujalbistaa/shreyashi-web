---
/**
 * The essays as cover lines: each is introduced by a sentence quoted verbatim from it,
 * swiped with a highlighter in its theme colour. Entries step in and out across the
 * grid like copy on a magazine cover. On hover the highlighter re-draws.
 */
import { essayHref, pad, type Essay } from '../lib/essays';

interface Props {
  essays: Essay[];
  summaries?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { essays, summaries = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;

// Hand-set rhythm across the 12-column grid: [start column, span].
const placement = [
  [1, 9],
  [4, 9],
  [2, 8],
  [5, 8],
  [1, 10],
];
---

<ol class="lines" role="list">
  {
    essays.map((essay, i) => {
      const d = essay.data;
      const [start, span] = placement[i % placement.length];
      return (
        <li class="entry" data-tint={d.theme} style={`--start: ${start}; --span: ${span}`}>
          <a class="link" href={essayHref(essay)}>
            <span class="spot" aria-hidden="true">
              {pad(d.number)}
            </span>
            <p class="quote">
              <span class="hl">“{d.coverLine}”</span>
            </p>
            <div class="credit">
              <Heading class="title">
                {d.title}
                {d.subtitle && <span class="sub">: {d.subtitle}</span>}
              </Heading>
              <span class="meta">
                <span class="tag">{d.theme}</span>
                <span class="label">
                  {d.year} · {d.readingTime} min
                </span>
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </span>
            </div>
            {summaries && <p class="summary">{d.summary}</p>}
          </a>
        </li>
      );
    })
  }
</ol>

<style>
  .lines {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-8);
  }

  .entry {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    column-gap: var(--gutter);
  }

  .link {
    position: relative;
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: inherit;
    text-decoration: none;
  }

  .link:hover {
    color: inherit;
  }

  .link:focus-visible {
    outline-offset: 8px;
  }

  /* The number, as a ladybird's spot stuck on the corner of the quote. */
  .spot {
    align-self: flex-start;
    display: grid;
    place-items: center;
    width: 2.6rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--red);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 85%;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums tabular-nums;
    rotate: -10deg;
    transition: rotate var(--dur-reveal) var(--ease);
  }

  .link:hover .spot,
  .link:focus-visible .spot {
    rotate: 8deg;
  }

  .quote {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 300;
    font-size: var(--step-3);
    line-height: 1.14;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  /* A highlighter pass across the lower half of each line. */
  .hl {
    padding-inline: 0.06em;
    background-image: linear-gradient(var(--tint), var(--tint));
    background-repeat: no-repeat;
    background-position: 0 88%;
    background-size: 100% 0.5em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  @keyframes mark {
    from {
      background-size: 0% 0.5em;
    }
  }

  .link:hover .hl,
  .link:focus-visible .hl {
    animation: mark 700ms var(--ease);
  }

  .credit {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
  }

  .title {
    font-size: var(--step-1);
    font-weight: 750;
    font-stretch: 85%;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .sub {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 300;
    font-stretch: 100%;
  }

  .meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }

  .arrow {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1;
    color: var(--red);
    transition: translate var(--dur-hover) var(--ease);
  }

  .link:hover .arrow,
  .link:focus-visible .arrow {
    translate: 6px 0;
  }

  .summary {
    max-width: 52ch;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-2);
  }

  @media (min-width: 48em) {
    .entry:nth-child(even) .link {
      grid-column: 2 / -1;
    }
    .entry:nth-child(odd) .link {
      grid-column: 1 / span 7;
    }
  }

  @media (min-width: 64em) {
    .entry .link,
    .entry:nth-child(even) .link,
    .entry:nth-child(odd) .link {
      grid-column: var(--start) / span var(--span);
    }

    /* Spot sticks out into the margin at the quote's top-left corner. */
    .spot {
      position: absolute;
      top: -0.6rem;
      left: -3.4rem;
      width: 3rem;
      font-size: 1.375rem;
    }

    .entry:first-child .spot,
    .entry:last-child .spot {
      left: -1.2rem;
      top: -2.6rem;
    }
  }
</style>
